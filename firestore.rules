rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menu items: readable by all, writable by users/owner
    match /menu_items/{itemId} {
      allow read, write: if true;
    }
    
    // Deals: readable by all, writable by users/owner
    match /deals/{dealId} {
      allow read, write: if true;
    }
    
    // Categories: readable by all, writable by users/owner
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    
    // Orders: customers can create orders, customers/owner can view & update status
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Restaurant Settings (passcode, operational status): accessible by the application
    match /settings/{settingId} {
      allow read, write: if true;
    }
    
    // Fallback for any other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
